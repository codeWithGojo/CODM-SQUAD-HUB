# Copy this file to .env and fill in real values before running.

DATABASE_URL=postgresql://user:password@localhost:5432/codm_squad_hub

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# SMS provider for delivering OTP codes (Termii / Africa's Talking recommended for Nigeria)
SMS_API_KEY=
SMS_SENDER_ID=SquadHub

# Firebase service account JSON for push notifications (scrim reminders, AI review ready)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Anthropic API key for AI weekly reviews
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
