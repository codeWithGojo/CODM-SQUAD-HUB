# Runtime
ENVIRONMENT=development
DATABASE_URL=sqlite+pysqlite:///./codm_squad_hub.db
AUTO_CREATE_TABLES=true
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Generate both secrets independently with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ANTI_ABUSE_SECRET=replace-with-a-different-long-random-string
ADMIN_PHONE_NUMBERS=

# Phone OTP / Termii. EXPOSE_DEV_OTP must remain false outside local development.
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_MIN_REQUEST_INTERVAL_SECONDS=60
EXPOSE_DEV_OTP=true
SMS_PROVIDER=termii
SMS_BASE_URL=https://api.ng.termii.com
SMS_API_KEY=
SMS_SENDER_ID=SquadHub

# AI coach: structured match/VOD tags only; no raw-video upload.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_ALLOW_RULES_FALLBACK=true

# Paystack (all API amounts are in kobo)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=

# Push notification delivery
FIREBASE_CREDENTIALS_PATH=
