{
  "expo": {
    "name": "CoDM Squad Hub",
    "slug": "codm-squad-hub",
    "scheme": "squadhub",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "android": {
      "package": "africa.codmsquadhub.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A"
      }
    },
    "ios": {
      "bundleIdentifier": "africa.codmsquadhub.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
